{
  "name": "rallivio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "canonical-check": "node scripts/check-canonical.js",
    "check:docs": "node scripts/check-docs.js",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run canonical-check && npm run check:docs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.24",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "vite": "7.1.5"
  }
}
