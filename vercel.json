{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/cron/acquire", "schedule": "0 2 * * *" },
    { "path": "/api/cron/refresh", "schedule": "0 8 * * *" },
    { "path": "/api/cron/signals", "schedule": "30 8 * * *" }
  ]
}
